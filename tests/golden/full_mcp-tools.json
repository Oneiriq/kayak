{
  "tools": [
    {
      "name": "files_list",
      "description": "List files for the authenticated tenant.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Rows per page, at most 100."
          },
          "cursor": {
            "type": "string",
            "description": "Resume from a previous page."
          },
          "state": {
            "type": "string",
            "description": "Filter by state."
          },
          "sort": {
            "type": "string",
            "description": "Sort column, one of: created_at. Suffix with :desc for newest first."
          }
        },
        "additionalProperties": false
      },
      "annotations": {}
    },
    {
      "name": "file_get",
      "description": "Fetch one of files by id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {}
    },
    {
      "name": "file_issue_url",
      "description": "Issue a signed URL for a servable file.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ttl_secs": {
            "type": "integer"
          },
          "max_uses": {
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {}
    },
    {
      "name": "file_remove",
      "description": "Soft-delete the file.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {}
    },
    {
      "name": "search",
      "description": "Retrieval across the tenant's text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "What to look for."
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "requiredScopes": [
          "read"
        ],
        "backing": [
          {
            "table": "text_chunk",
            "column": "body",
            "index": "idx_chunk_body",
            "kind": "lexical"
          },
          {
            "table": "text_chunk",
            "column": "embedding",
            "index": "idx_chunk_embedding",
            "kind": "vector"
          }
        ]
      }
    },
    {
      "name": "file_text",
      "description": "The file_text query.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "requiredScopes": [
          "read"
        ]
      }
    }
  ]
}
