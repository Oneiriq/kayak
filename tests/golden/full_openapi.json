{
  "components": {
    "schemas": {
      "File": {
        "properties": {
          "content_type": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "path": {
            "type": "string"
          },
          "size": {
            "type": [
              "integer",
              "null"
            ]
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "state",
          "content_type",
          "metadata",
          "created_at"
        ],
        "type": "object"
      },
      "FilePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/File"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "Opaque keyset cursor for the next page; null when drained.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "copal",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/files": {
      "get": {
        "operationId": "list_files",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 100,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor from a previous page's next_cursor.",
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by state (indexed).",
            "in": "query",
            "name": "state",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Sort order; every value is backed by an index.",
            "in": "query",
            "name": "sort",
            "schema": {
              "enum": [
                "created_at",
                "-created_at"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FilePage"
                }
              }
            },
            "description": "Page of resources."
          }
        }
      }
    },
    "/v1/files/{id}": {
      "delete": {
        "description": "Soft-delete the file.",
        "operationId": "remove_files",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No content."
          }
        }
      },
      "get": {
        "operationId": "get_files",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/File"
                }
              }
            },
            "description": "The resource."
          },
          "404": {
            "description": "Not found."
          }
        }
      }
    },
    "/v1/files/{id}/text": {
      "get": {
        "operationId": "file_text",
        "parameters": [
          {
            "description": null,
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "the answer"
          }
        },
        "summary": null
      }
    },
    "/v1/files/{id}/url": {
      "post": {
        "description": "Issue a signed URL for a servable file.",
        "operationId": "issue_url_files",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "max_uses": {
                    "type": "integer"
                  },
                  "ttl_secs": {
                    "type": "integer"
                  }
                },
                "required": [],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Action result."
          }
        }
      }
    },
    "/v1/search": {
      "get": {
        "description": "Search backing: lexical via idx_chunk_body over text_chunk.body; vector via idx_chunk_embedding over text_chunk.embedding where configured.",
        "operationId": "search",
        "parameters": [
          {
            "description": "What to look for.",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": null,
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "the answer"
          }
        },
        "summary": "Retrieval across the tenant's text."
      }
    }
  }
}
